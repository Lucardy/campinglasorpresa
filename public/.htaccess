# Habilitar el motor de reescritura
RewriteEngine On

# Establecer la base de reescritura
RewriteBase /

# Si el archivo o directorio existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# NO redirigir peticiones a la API - dejar que fallen naturalmente
RewriteCond %{REQUEST_URI} !^/api/

# Si no existe y NO es una petición a la API, redirigir a index.html
RewriteRule ^(.*)$ index.html [L]

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE text/cache-manifest
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger archivos específicos
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Configuración de seguridad y NO-CACHE
<IfModule mod_headers.c>
    # Headers de seguridad
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set X-Download-Options "noopen"
    Header set X-Permitted-Cross-Domain-Policies "none"
    Header set X-Requested-With "XMLHttpRequest"
    Header set X-Robots-Tag "index, follow"

    # Evitar cache en TODOS los archivos
    <FilesMatch "\.(html|htm|js|css|json|xml|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Configuración de MIME types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/cache-manifest .appcache
    AddType image/svg+xml .svg
    AddType application/x-font-woff .woff
    AddType application/x-font-woff2 .woff2
</IfModule>

# Configuración de redirecciones SEO
<IfModule mod_rewrite.c>
    # Redirigir HTTP a HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirigir trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} /+[^?\s]*//
    RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# Compresión adicional Brotli
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/xml+rss application/json
</IfModule>

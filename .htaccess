# Habilitar el motor de reescritura
RewriteEngine On

# Establecer la base de reescritura
RewriteBase /

# Si el archivo o directorio existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# NO redirigir peticiones a la API - dejar que fallen naturalmente
RewriteCond %{REQUEST_URI} !^/api/

# Si no existe y NO es una petición a la API, redirigir a index.html
RewriteRule ^(.*)$ index.html [L] 